+	std::vector<recent_replay_death> recent_replay_deaths;
+	int replay_warning_frame = -1;
+
+	void on_unit_destroy(unit_t* unit) override {
+		if (replay_warning_frame >= 0) return;
+		while (!recent_replay_deaths.empty() &&
+		       st.current_frame - recent_replay_deaths.front().frame > 12) {
+			recent_replay_deaths.erase(recent_replay_deaths.begin());
+		}
+		recent_replay_deaths.push_back({st.current_frame, get_unit_id(unit).raw_value,
+		                               get_unit_id_32(unit).raw_value});
+	}
+
+	void on_missing_replay_selection(uint32_t id, bool wide) override {
+		if (replay_warning_frame >= 0) return;
+		for (const auto& death : recent_replay_deaths) {
+			const int elapsed = st.current_frame - death.frame;
+			if (elapsed >= 0 && elapsed <= 12 &&
+			    id == (wide ? death.wide_id : death.narrow_id)) return;
+		}
+		replay_warning_frame = st.current_frame;
 	}
 
